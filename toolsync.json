{
  "@toolsync/builtin/github-actions": {},
  "@toolsync/builtin/bun": {},
  "@toolsync/builtin/ignore-sync": {},
  "@toolsync/builtin/package-meta": {
    "publishConfig": {
      "access": "public"
    }
  },
  "@toolsync/builtin/package-readme": {},
  "@toolsync/builtin/turbo": {
    "concurrency": "15",
    "tasks": {
      "test:integration": {
        "dependsOn": ["build"]
      }
    }
  },
  "@toolsync/builtin/vscode": {
    "settings": {
      "oxc.enable": true,
      "editor.defaultFormatter": "oxc.oxc-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit"
      },
      "json.schemaDownload.trustedDomains": {
        "https://openapi.vercel.sh": true
      }
    }
  },
  "@toolsync/builtin/publint": {
    "version": "catalog:"
  },
  "@repo/toolsync-plugin": {}
}
