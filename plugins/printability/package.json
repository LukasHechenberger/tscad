{
  "name": "@tscad/plugin-printability",
  "version": "0.0.0",
  "description": "Overhangs, bed contact and fit for 3D printing: an analysis plugin for tscad",
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git",
    "directory": "plugins/printability"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/plugin.component.wasm"
  ],
  "tscad": {
    "plugin": "./dist"
  },
  "scripts": {
    "build": "tscad-plugin build",
    "check:exports": "publint"
  },
  "devDependencies": {
    "@tscad/plugin-sdk": "workspace:*",
    "publint": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
