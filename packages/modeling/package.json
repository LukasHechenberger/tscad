{
  "name": "@tscad/modeling",
  "version": "0.5.0",
  "description": "OpenSCAD-style modeling in TypeScript: shapes as a CSG tree for the tscad kernel",
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git",
    "directory": "packages/modeling"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "require": "./out/index.cjs",
      "default": "./out/index.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:exports": "publint",
    "check:types": "tsc --noEmit",
    "dev": "bun scripts/build.ts --watch",
    "lint": "oxlint --deny-warnings",
    "test": "bun test"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.9",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
