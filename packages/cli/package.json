{
  "name": "@tscad/cli",
  "version": "0.4.2",
  "description": "A CLI tool for working with tscad models",
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "tscad": "./out/bin.js"
  },
  "scripts": {
    "build": "rslib build",
    "check:exports": "publint",
    "check:types": "tsc --noEmit",
    "dev": "rslib dev --watch",
    "dev:on-success": "PORT=3999 bun out/bin.js dev --model ../../examples/gridfinity-generator/src/model.ts",
    "lint": "oxlint --deny-warnings",
    "test": "bun test"
  },
  "dependencies": {
    "@tscad/kernel": "workspace:*",
    "@tscad/modeling": "workspace:*",
    "@tscad/plugin-host": "workspace:*",
    "@tscad/viewer": "workspace:*",
    "change-case": "^5.4.4",
    "commander": "^14.0.2",
    "debug": "^4.4.3",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@rslib/core": "^0.17.2",
    "@toolsync/template": "^0.1.1",
    "@tscad/commander": "workspace:*",
    "@types/bun": "^1.3.9",
    "@types/debug": "^4.1.12",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "rsbuild-exec": "workspace:*",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
