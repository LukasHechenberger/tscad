{
  "name": "@tscad/viewer",
  "version": "0.2.2",
  "description": "A viewer for tscad models",
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git",
    "directory": "packages/viewer"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/viewer.ts",
