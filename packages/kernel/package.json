{
  "name": "@tscad/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "The tscad CAD kernel: evaluates modeling trees with OpenCASCADE, natively in Bun and as WebAssembly",
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git",
    "directory": "packages/kernel"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": {
        "types": "./out/types/bun.d.ts",
        "default": "./out/bun.js"
      },
      "node": {
        "types": "./out/types/node.d.ts",
        "default": "./out/node.js"
      },
      "types": "./out/types/index.d.ts",
      "default": "./out/index.js"
    },
    "./kernel.wasm": "./kernel.wasm"
  },
  "files": [
    "out",
    "kernel.wasm"
  ],
  "scripts": {
    "build": "bun scripts/build.ts js native",
    "build:wasm": "bun scripts/build.ts wasm",
    "check:types": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "bun test"
  },
  "dependencies": {
    "@tscad/modeling": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.9",
    "typescript": "catalog:"
  }
}
