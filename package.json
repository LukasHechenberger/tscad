{
  "name": "tscad",
  "version": "0.0.0",
  "private": true,
  "description": "A modern CAD modeller for programmers",
  "keywords": [],
  "homepage": "https://tscad.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/tscad.git"
  },
  "license": "MIT",
  "author": "Lukas Hechenberger <npm@ls-age.com> (https://ls-age.com/)",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "22.19.1",
      "@types/react": "^19.2.6",
      "@types/react-dom": "^19.2.3",
      "publint": "0.3.15",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "changesets:publish": "for dir in packages/*; do (cd \"$dir\" && bun publish || exit 0); done && changeset tag",
    "changesets:version": "changeset version && bun install",
    "check": "turbo run check",
    "check:format": "oxfmt --check",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "ignore-sync": "ignore-sync .",
    "lint": "turbo run lint",
    "prepare": "bun --bun toolsync prepare --config toolsync.json && ignore-sync .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@repo/toolsync-plugin": "workspace:*",
    "@toolsync/builtin": "^0.6.4",
    "@toolsync/cli": "0.4.5",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-turbo": "^2.6.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "ignore-sync": "^8.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.8.12"
  },
  "packageManager": "bun@1.4.3"
}
